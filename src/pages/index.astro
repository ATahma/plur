---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="canopée">
  <div class="index-content framed">
    <h1 id="hello-there">canopée présente <i>lowpass</i></h1>


    <h1> get ready for a wall of bass </h1>

    <p>
      we are taking our 2 subs to <a href=https://www.instagram.com/vive.la.recre/?hl=en>la récré </a> to pair with their 2 Technics Stack & extra double 18" subwoofer. 
      We will be serving heavy, dark basslines all night, on a soundsystem that you can feel in your whole body.
    </p>

    <p>
      The bar area will also have vendors from 7pm onwards, with ambient tunes to start the night. Vendor list will be anounced shortly on our instagram.
    </p>
    
    <h1> Djs, in playing order: </h1>
    <p> 
    <a href=https://www.instagram.com/jacobzweig > 10toeflex </a> </br>
    <a href=https://www.instagram.com/vidamaninkari > mauna </a> </br>
    <a href=https://www.instagram.com/j.rom___ > j.rom</a>  </br>
    <a href=https://www.instagram.com/xoxoxo.dawny > dawny </a> </br> 
    <a href=https://www.instagram.com/sloan.porter > sloan porter </a> </br>
    <a href=https://www.instagram.com/friday.aiff >  friday </a> </br>
    </p>

    <p>
    poster by <a href=https://www.instagram.com/arliedotcom> arliedotcom </a>
    </p>


        <p>
      <a href="https://www.zeffy.com/en-CA/ticketing/lowpass">
        <img src="/lowpass-poster.jpeg" alt="Lowpass Poster" />
      </a>
    </p>
  
  </div>
  
  <div class="posts">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>